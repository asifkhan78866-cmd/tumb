# ML artifacts / data (keep folder via .gitkeep)
backend/weights/*.pth
# ...but ship the trained classifier so inference works out of the box.
!backend/weights/best_classifier.pth
# ...and the Method 1 classifier trained with SFLA-selected hyper-parameters.
backend/weights/method1/*
!backend/weights/method1/best_classifier.pth
!backend/weights/method1/best_classifier.pth.meta.json
!backend/weights/method1/model_metadata.json
!backend/weights/method1/best_unet.pth
!backend/weights/method1/best_unet.pth.meta.json
# ...and the SVM that classifies its SFLA-selected ConvLSTM features.
!backend/weights/method1/feature_svm.joblib
!backend/weights/method1/feature_svm_metadata.json
# ...and the volumetric U-Net trained on Decathlon (BraTS) volumes.
!backend/weights/method1/best_unet3d.pth
!backend/weights/method1/best_unet3d.pth.meta.json
# ...the MRI-SPECT fusion method's trained MRI branch...
!backend/weights/method2_dcn.pth
!backend/weights/method2_model_metadata.json
# ...and its multi-class segmentation head.
!backend/weights/method2_segmentation.pth
!backend/weights/method2_segmentation.pth.meta.json
# ...and the transfer-learning and Red Fox ZFNet classifiers.
backend/weights/method3/*
!backend/weights/method3/best_classifier.pth
!backend/weights/method3/best_classifier.pth.meta.json
!backend/weights/method3/model_metadata.json
backend/weights/method4/*
!backend/weights/method4/best_classifier.pth
!backend/weights/method4/best_classifier.pth.meta.json
!backend/weights/method4/model_metadata.json
# ...and the SVM that classifies its Red Fox-selected features (220 KB).
!backend/weights/method4/rfo_svm.joblib
!backend/weights/method4/feature_svm_metadata.json

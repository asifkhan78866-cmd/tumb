# =============================================================================
# NeuroSeg AI — environment configuration
#
#   cp .env.example .env     then fill in the values you need.
#
# .env is git-ignored. Never commit real credentials.
#
# SECURITY: KAGGLE_KEY and HF_TOKEN are read ONLY by the FastAPI backend
# process. They must never be given a NEXT_PUBLIC_ prefix — Next.js inlines
# every NEXT_PUBLIC_* value into the JavaScript bundle it ships to the browser,
# which would publish the secret to anyone who opens the page.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development            # development | production
                              # development also enables clearly-labelled
                              # PLACEHOLDER visuals when weights are missing.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Data --------------------------------------------------------------------
# DATA_ROOT is the default parent for every dataset below.
DATA_ROOT=backend/dataset
# Leave BRI_DATASET_PATH unset and the backend finds the dataset by itself: it
# looks for a folder that directly contains Training/ and Testing/ (each with
# glioma, meningioma, notumor, pituitary) in data/bri/archive, data/bri,
# data/archive, archive, dataset/archive, backend/dataset/brain-tumor-mri-dataset.
# So an unzipped "archive" folder in the project root just works.
# Set it only to point somewhere else; an explicit value is always obeyed, even
# if it does not exist, so a wrong path fails loudly instead of training on a
# directory nobody chose.
# BRI_DATASET_PATH=./data/bri/archive
BRATS_DATASET_PATH=backend/dataset/brats2020-training-data
SPECT_DATASET_PATH=backend/dataset/spect

# --- Dataset download (backend process only — never exposed to the browser) ---
# Kaggle: https://www.kaggle.com/settings -> "Create New API Token"
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional, and only needed for gated/private Hugging Face assets.
HF_TOKEN=

# Kaggle dataset slugs (override only to use different sources).
# KAGGLE_CLASSIFICATION=masoudnickparvar/brain-tumor-mri-dataset
# KAGGLE_SEGMENTATION=awsaf49/brats2020-training-data

# --- Model weights -----------------------------------------------------------
# Each method owns its own checkpoints; they are never interchangeable. Loading
# a checkpoint from the wrong method fails loudly rather than silently.
#
# LEAVE THESE COMMENTED OUT unless you deliberately want to pin a file.
# By default Method 1 resolves to backend/weights/method1/<name>.pth when it
# exists and falls back to the legacy flat path otherwise, so a freshly trained
# checkpoint is picked up automatically. Setting them explicitly overrides that
# — which is how you end up training a new model and still serving the old one.
# METHOD1_UNET_WEIGHTS=backend/weights/method1/best_unet.pth
# METHOD1_CONVLSTM_WEIGHTS=backend/weights/method1/best_classifier.pth
METHOD2_SEGMENTATION_WEIGHTS=backend/weights/method2_segmentation.pth
METHOD2_DCN_WEIGHTS=backend/weights/method2_dcn.pth

# --- Method 2 modality -------------------------------------------------------
# The reference diagram writes "Photon Emission Computed Tomography (PECT)"
# while the dataset in use is SPECT (Single Photon Emission CT). They are not
# synonyms. METHOD2_MODALITY is the real modality and is what the UI, the API
# and the PDF report display. METHOD2_SPEC_MODALITY_LABEL is only rendered
# where the research specification's own wording is explicitly required.
METHOD2_MODALITY=SPECT
METHOD2_SPEC_MODALITY_LABEL=PECT

# --- Method 2 AI assessment (vision-language model) --------------------------
# While Method 2's DCN has no trained checkpoint, uploads can be assessed by an
# AI model instead. The result is labelled as an AI model's assessment
# everywhere (API, UI, PDF): it is not the DCN, has no measured accuracy, and
# its percentages are uncalibrated. Nothing is written to the metrics files.
# Keys stay on the backend.
METHOD2_AI_ENABLED=false
# openrouter (default): free model first, then cheap fallbacks.
METHOD2_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# METHOD2_AI_MODEL=nex-agi/nex-n2.5-pro:free
# Free-only by default. With OpenRouter credits you can append a cheap paid model:
# METHOD2_AI_FALLBACK_MODELS=inclusionai/ling-3.0-flash-vl:free,google/gemma-4-31b-it:free,google/gemini-2.5-flash-lite
# anthropic: set METHOD2_AI_PROVIDER=anthropic and ANTHROPIC_API_KEY (Claude).
ANTHROPIC_API_KEY=
# METHOD2_AI_TIMEOUT_S=90

# --- Optimization (Method 1: Shuffled Frog Leaping Algorithm) ----------------
# SFLA_ENABLED=true makes training load the best parameters from
# backend/logs/method1_sfla_result.json. With it false the search still runs and
# records its result, but training keeps the defaults.
SFLA_ENABLED=false
SFLA_SEED=42
SFLA_POPULATION=20
SFLA_MEMEPLEXES=4
SFLA_ITERATIONS=10
SFLA_LOCAL_ITERATIONS=5

# --- Runtime -----------------------------------------------------------------
DEVICE=auto                   # auto | cpu | cuda
MODEL_CACHE_DIR=backend/.model_cache
MAX_UPLOAD_MB=20
RANDOM_SEED=42

# --- Training hyper-parameters (optional overrides) --------------------------
SEG_EPOCHS=50
CLS_EPOCHS=40
BATCH_SIZE=16
LEARNING_RATE=0.001
NUM_WORKERS=2
EARLY_STOP_PATIENCE=10

# --- Training over HTTP ------------------------------------------------------
# POST /api/train/{method_id} returns the command to run instead of executing
# it unless this is true. Leave it false on any host that is reachable by
# anyone else: an unauthenticated endpoint that starts a multi-hour GPU job is
# a denial-of-service primitive.
TRAINING_API_ENABLED=false
